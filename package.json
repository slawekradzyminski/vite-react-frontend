{
  "name": "vite",
  "private": true,
  "version": "3.14.0",
  "type": "module",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:analyze": "tsc -b && vite build --mode analyze",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run",
    "test:watch": "vitest watch",
    "test:e2e": "playwright test",
    "test:e2e:ai": "playwright test --reporter=list",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "regression": "npm test && npm run build && npm run test:e2e:ai",
    "test:e2e:commerce": "playwright test --config=playwright.commerce.config.ts",
    "typecheck": "tsc -b",
    "api:snapshot": "node scripts/api-contract.mjs snapshot backend && npm run api:generate:backend",
    "api:snapshot:warehouse": "node scripts/api-contract.mjs snapshot warehouse && npm run api:generate:warehouse",
    "api:snapshot:payment": "node scripts/api-contract.mjs snapshot payment && npm run api:generate:payment",
    "api:generate": "npm run api:generate:backend && npm run api:generate:warehouse && npm run api:generate:payment",
    "api:generate:backend": "openapi-typescript openapi/backend-api-docs.json --output src/types/generated/backend-api.ts",
    "api:generate:warehouse": "openapi-typescript openapi/warehouse-api-docs.json --output src/types/generated/warehouse-api.ts",
    "api:generate:payment": "openapi-typescript openapi/payment-api-docs.json --output src/types/generated/payment-api.ts",
    "api:check": "node scripts/api-contract.mjs check backend",
    "api:check:warehouse": "node scripts/api-contract.mjs check warehouse",
    "api:check:payment": "node scripts/api-contract.mjs check payment",
    "demo:webmcp": "vite --config vite.webmcp.config.ts",
    "test:e2e:webmcp": "playwright test --config playwright.webmcp.config.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.2",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toast": "^1.3.1",
    "@radix-ui/themes": "^3.3.0",
    "@stomp/stompjs": "^7.5.0",
    "@tanstack/react-query": "^5.107.1",
    "axios": "^1.21.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.70.0",
    "postcss": "^8.5.32",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-markdown": "^10.1.0",
    "react-router": "^8.5.1",
    "sockjs-client": "^1.6.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "1.64.0",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^4.1.12",
    "@vitest/ui": "^4.1.12",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "graphql": "^17.1.0",
    "jsdom": "^30.1.3",
    "openapi-typescript": "7.13.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "qs": "6.17.1",
    "@tailwindcss/typography": {
      "postcss-selector-parser": "7.1.7"
    },
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
}
